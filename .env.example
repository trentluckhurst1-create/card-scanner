EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_AU
CARD_SCANNER_DB=data/card_scanner.sqlite3
MIN_OPPORTUNITY_SCORE=75
MARKET_CACHE_HOURS=6
MAX_MARKET_QUERIES_PER_RUN=25
EBAY_RESULTS_PER_QUERY=25
CHERRY_PAGE_SIZE=250
CHERRY_MAX_PRODUCTS_PER_SPORT=5000
CHERRY_SCAN_CACHE_MINUTES=30
CHERRY_MISSING_SCAN_THRESHOLD=3
EXACT_COMP_MAX_AGE_DAYS=365
RELATED_COMP_MAX_AGE_DAYS=180
MIN_EXACT_COMPS_HIGH_CONFIDENCE=3
MIN_TOTAL_COMPS_MEDIUM_CONFIDENCE=3
OUTLIER_IQR_MULTIPLIER=1.5
QUICK_SALE_DISCOUNT=0.85
OPPORTUNITY_MIN_IDENTITY_CONFIDENCE=0.70
OPPORTUNITY_MIN_COMP_CONFIDENCE=0.55
OPPORTUNITY_BUY_EDGE_PCT=25
OPPORTUNITY_STRONG_BUY_EDGE_PCT=45
CHERRY_SHIPPING_AUD=

# The Card API - free tier is EPHEMERAL / NON-COMMERCIAL only.
# Never commit a real API key.
THE_CARD_API_KEY=
THE_CARD_API_BASE_URL=https://thecardapi.com/api/v1/market/sales
THE_CARD_API_RESULTS_PER_QUERY=100
THE_CARD_API_RECENT_DAYS=3

# Reserve Bank of Australia Statistical Table F11.1.
# Rates are units of foreign currency per A$1.
RBA_FX_CSV_URL=https://www.rba.gov.au/statistics/tables/csv/f11.1-data.csv

# Automatic ephemeral Cherry opportunity scanner
OPPORTUNITY_SCAN_LISTINGS_PER_SPORT=50
OPPORTUNITY_SCAN_MAX_CANDIDATES_PER_SPORT=10
OPPORTUNITY_SCAN_SOLD_RESULTS_PER_QUERY=100
OPPORTUNITY_SCAN_MAX_SOLD_QUERIES=80
